{
  "$id": "dvrk-system.schema.json",
  "$version": "1",
  "component_manager": {
    "components": [
      {
        "shared-library": "sawOpenXR",
        "class-name": "mtsOpenXR",
        "constructor-arg": {
          "Name": "OpenXR"
        },
        "configure-parameter": "sawOpenXR-pybullet-dual-console.json"
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {
          "Name": "PSM1",
          "Period": 0.01
        }
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {
          "Name": "PSM2",
          "Period": 0.01
        }
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {
          "Name": "PSM3",
          "Period": 0.01
        }
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_arm_from_ros",
        "constructor-arg": {
          "Name": "ECM",
          "Period": 0.01
        }
      }
    ]
  },
  "IOs": [
    {
      "name": "IO",
      "port": "udpfw",
      "protocol": "srbw"
    }
  ],
  "arms": [
    {
      "name": "MTML",
      "type": "MTM",
      "serial": "22723",
      "IO": "IO",
