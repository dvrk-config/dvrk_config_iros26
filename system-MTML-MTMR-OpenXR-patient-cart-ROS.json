            "start_gripper_threshold": 0.0,
            "gripper_scaling": {
              "zero": 0.3490658504,
              "max": 1.7453292520
            },
            "scale": 0.3
          }
        },
        {
          "MTM": "Meta_MTML",
          "PSM": "PSM2",
          "clutch": {
            "component": "OpenXR",
            "interface": "Console/clutch/MTML"
          },
          "configure_parameter": {
            "MTM_is_haptic": false,
            "align_MTM": false,
            "use_MTM_linear_velocity": false,
            "use_MTM_angular_velocity": false,
            "ignore_jaw": false,
            "start_gripper_threshold": 0.0,
            "gripper_scaling": {
              "zero": 0.3490658504,
              "max": 1.7453292520
            },
            "scale": 0.3
          }
        },
        {
          "MTM": "Meta_MTML",
          "PSM": "PSM3",
          "clutch": {
            "component": "OpenXR",
            "interface": "Console/clutch/MTML"
          },
          "configure_parameter": {
            "MTM_is_haptic": false,
            "align_MTM": false,
            "use_MTM_linear_velocity": false,
            "use_MTM_angular_velocity": false,
            "ignore_jaw": false,
            "start_gripper_threshold": 0.0,
            "gripper_scaling": {
              "zero": 0.3490658504,
              "max": 1.7453292520
            },
            "scale": 0.3
          }
        }
      ],
      "teleop_ECMs": [
        {
          "MTML": "Meta_MTML",
          "MTMR": "Meta_MTMR",
          "ECM": "ECM",
          "configure_parameter": {
            "MTM_is_haptic": false,
            "check_MTMs_workspace": false,
            "haptic_feedback_ratio": 0.0
          }
        }
      ]
    }
  ]
}
