        "reference_frame": "HRSV",
        "transform": [
          [-1.0, 0.0, 0.0, 0.180],
          [0.0, 0.866025404, 0.5, 0.400],
          [0.0, 0.5, -0.866025404, 0.475],
          [0.0, 0.0, 0.0, 1.0]
        ]
      }
    },
    {
      "name": "MTMR",
      "type": "MTM",
      "serial": "22403",
      "IO": "IO",
      "base_frame": {
        "reference_frame": "HRSV",
        "transform": [
          [-1.0, 0.0, 0.0, -0.180],
          [0.0, 0.866025404, 0.5, 0.400],
          [0.0, 0.5, -0.866025404, 0.475],
          [0.0, 0.0, 0.0, 1.0]
        ]
      }
    },
    {
      "name": "Meta_MTML",
      "type": "MTM_GENERIC",
      "component": "OpenXR",
      "interface": "MTML"
    },
    {
      "name": "Meta_MTMR",
      "type": "MTM_GENERIC",
      "component": "OpenXR",
      "interface": "MTMR"
    },
    {
      "name": "PSM1",
      "type": "PSM_GENERIC",
      "component": "PSM1",
      "interface": "PSM1",
      "skip_ROS_bridge": true
    },
    {
      "name": "PSM2",
      "type": "PSM_GENERIC",
      "component": "PSM2",
      "interface": "PSM2",
      "skip_ROS_bridge": true
    },
    {
      "name": "PSM3",
      "type": "PSM_GENERIC",
      "component": "PSM3",
      "interface": "PSM3",
      "skip_ROS_bridge": true
    },
    {
      "name": "ECM",
      "type": "ECM_GENERIC",
      "component": "ECM",
      "interface": "ECM",
      "skip_ROS_bridge": true
    }
  ],
  "consoles": [
    {
      "name": "console",
      "input_type": "PEDALS_GOOVIS_HEAD_SENSOR",
      "IO_pedals": {
        "IO": "IO",
        "IO_file": "io/sawRobotIO1394-MTMR-foot-pedals-QLA1.json"
      },
      "HID_file": "hid/goovis-hd.json",
      "teleop_PSMs": [
